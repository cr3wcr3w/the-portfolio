---
import { SITE_TITLE } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<a class="footer-brand" href="/">{SITE_TITLE}</a>
		<p>A personal portfolio and blog about software, networks, and cybersecurity.</p>
		<div class="footer-bottom">
			<span>&copy; {currentYear} {SITE_TITLE}</span>
			<a href="/rss.xml">Subscribe via RSS <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 2.5rem 2rem 1.5rem;
		border-top: 3px double var(--ink);
		color: var(--muted);
	}
	.footer-inner {
		max-width: 1120px;
		margin: 0 auto;
	}
	.footer-brand {
		color: var(--ink);
		font-family: var(--serif);
		font-size: 1.7rem;
		font-weight: 700;
		text-decoration: none;
	}
	footer p {
		margin: 0.25rem 0 1.5rem;
		font-size: 0.85rem;
	}
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.8rem;
		border-top: 1px solid var(--rule);
		font-family: var(--mono);
		font-size: 0.65rem;
		text-transform: uppercase;
	}
	.footer-bottom a {
		color: var(--ink);
		text-decoration: none;
	}
	.footer-bottom a:hover {
		color: var(--accent);
	}
	@media (max-width: 600px) {
		footer {
			padding: 2rem 1rem 1.25rem;
		}
	}
</style>

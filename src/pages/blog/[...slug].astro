---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newerPost: index > 0
				? { id: posts[index - 1].id, title: posts[index - 1].data.title }
				: undefined,
			olderPost: index < posts.length - 1
				? { id: posts[index + 1].id, title: posts[index + 1].data.title }
				: undefined,
		},
	}));
}
type StoryLink = { id: string; title: string };
type Props = {
	post: CollectionEntry<'blog'>;
	newerPost?: StoryLink;
	olderPost?: StoryLink;
};

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} newerPost={newerPost} olderPost={olderPost}>
	<Content />
</BlogPost>
